<section class="team">
  <h3 class="section-title">{{ team.title }}</h3>
  <div class="team__grid">
    {% for member in team.members %}
    <div class="team__member">
      <div class="team__photo-wrapper">
        <img 
          src="/images/{{ member.image.src }}.jpg" 
          alt="{{ member.image.alt }}" 
          class="team__photo" 
          loading="lazy" 
          decoding="async"
        />
      </div>
      <h4 class="team__name">{{ member.name }}</h4>
      <p class="team__role">{{ member.role }}</p>
      <ul class="team__socials">
        {% for social in member.socials %}
        <li>
          <a href="{{ social.url }}" aria-label="{{ social.platform }}">
            <img 
              src="{{ social.icon }}" 
              alt="{{ social.alt }}" 
              class="team__icon"
              loading="lazy" 
              decoding="async"
            />
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
</section>
