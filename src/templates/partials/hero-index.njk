<section class="hero">
  <h1 class="hero__heading">
    WITH <span class="text-blue"> {{ platform }} </span> EXPLORE NFT COLLECTION
  </h1>
  <h2 class="hero__subheading">
    {{ tagline }}
  </h2>
  <div class="hero__stats">
    <div>
      <p class="hero__stat-number">{{ stats.totalItems }}</p>
      <p class="hero__stat-item">Total item</p>
      <button class="button button--primary">{{ buttons.connectWallet }}</button>
    </div>
    <div>
      <p class="hero__stat-number">{{ stats.whitelistProfiles }}</p>
      <p class="hero__stat-item">Profiles Whitelist</p>
      <button class="button button--secondary">{{ buttons.whitelistNow }}</button>
    </div>
  </div>

  <img
    src="{{ hero.image.src }}"
    width="{{ hero.image.width }}"
    height="{{ hero.image.height }}"
    loading="eager"
    decoding="async"
    alt="{{ hero.image.alt }}"
    class="hero__image"
  />

  <picture
    class="hero__image{% if binacube.isSmall %} hero__image--small{% endif %}{% if image.binacube %} hero__image--custom{% endif %}"
  >
    <source
      srcset="/img/{{ image.binacube }}-1x.avif 1x, /img/{{ image.binacube }}-2x.avif 2x"
      type="image/avif"
    />
    <source
      srcset="/img/{{ image.binacube }}-1x.webp 1x, /img/{{ image.binacube }}-2x.webp 2x"
      type="image/webp"
    />
    <img
      src="/img/{{ image.binacube }}.png"
      alt="Cube"
      width="533"
      height="641"
    />
  </picture>
</section>
