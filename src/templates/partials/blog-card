{% for blog in blogCard %}
<article class="">
  <picture class="">
    <source
      srcset="/img/{{ blog.img }}-1x.avif 1x, /img/{{ blog.img }}-2x.avif 2x"
      type="image/avif"
    />
    <source
      srcset="/img/{{ blog.img }}-1x.webp 1x, /img/{{ blog.img }}-2x.webp 2x"
      type="image/webp"
    />
    <img
      class=""
      src="/img/{{ blog.img }}-2x.webp"
      alt="{{ blog.alt }}"
      width="736"
      height="664"
      loading="lazy"
    />
  </picture>
  <div class="">
    <span class="">{{ blog.label }}</span>
  </div>
  <div class="">
    <img
      class=""
      src="{{ blog.authorIcon }}"
      alt="{{ blog.authorIconAlt }}"
      loading="lazy"
    />
    <span class="">{{ blog.authorName }}</span>
    <img
      class=""
      src="{{ blog.dateIcon }}"
      alt="{{ blog.dateIconAlt }}"
      loading="lazy"
    />
    <time class="b" datetime="2022-06-20"
      >{{ blog.dateISO }}</time
    >
  </div>
  <h4 class="">{{ blog.cardTitle }}</h4>
  <p class="">{{ blog.cardDescription }}</p>
  <a class="" href="{{ blog.link }}">{{ blog.linkText }}</a>
</article>
{% endfor %}